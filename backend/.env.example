PORT=3001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Frontend URL (for PayPal return/cancel redirects)
FRONTEND_URL=http://localhost:5173

# Set to "true" to enable /api/dev/purchase (no Gemini needed)
ENABLE_DEV_ROUTES=true

# Channel3 Product Search Sponsor API (optional fallback built-in)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.channel3.com/v1

CHANNEL3_BASE_URL=https://api.channel3.com/v1